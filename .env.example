# Database
DATABASE_URL=postgres://opennvr:opennvr_secret@localhost:5432/opennvr

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=opennvr
MINIO_SECRET_KEY=opennvr_secret
MINIO_BUCKET=opennvr-recordings

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=opennvr
KEYCLOAK_CLIENT_ID=opennvr-backend
KEYCLOAK_CLIENT_SECRET=opennvr-backend-secret
KEYCLOAK_ADMIN_PASSWORD=admin

# Server
BIND_ADDRESS=0.0.0.0:8888
CORS_ALLOWED_ORIGINS=http://localhost:3000
RUST_LOG=info,open_nvr=debug

# Frontend
NUXT_PUBLIC_API_URL=http://localhost:8888
NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NUXT_PUBLIC_KEYCLOAK_REALM=opennvr
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=opennvr-frontend

# Encryption key for camera credentials (generate with: openssl rand -hex 32)
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# AI Models
ONNX_MODEL_PATH=./ai-models/models

# NATS Message Broker
NATS_URL=nats://localhost:4222

# OpenSearch (optional - start with: docker compose --profile logging up -d)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_ENABLED=false
OPENSEARCH_INDEX_AUDIT=opennvr-audit-logs
OPENSEARCH_INDEX_NETWORK=opennvr-network-events

# --- Recording storage & rotation ---
# Where MP4 segments are written. Must be on a persistent disk (NOT /tmp).
RECORDINGS_DIR=./recordings
# Rotation kicks in above this filesystem usage (percent of the recordings
# partition, matches `df` Use%). Default 80.
RECORDINGS_MAX_DISK_PERCENT=80
# How far below the cap one rotation pass frees, to avoid deleting every tick.
RECORDINGS_RECLAIM_MARGIN_PERCENT=5
# Hard age cap in days. 0 = disk cap only (keep as much history as fits).
RECORDINGS_RETENTION_DAYS=0
# How often the rotation check runs, in seconds.
RECORDINGS_ROTATION_INTERVAL_SECS=300
# Where per-camera ffmpeg stderr is written (diagnostics for failed streams).
FFMPEG_LOG_DIR=/tmp/opennvr-ffmpeg-logs
