# Database
DATABASE_URL=postgres://opennvr:opennvr_secret@localhost:5432/opennvr

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=opennvr
MINIO_SECRET_KEY=opennvr_secret
MINIO_BUCKET=opennvr-recordings

# Keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=opennvr
KEYCLOAK_CLIENT_ID=opennvr-backend
KEYCLOAK_CLIENT_SECRET=opennvr-backend-secret

# Server
BIND_ADDRESS=0.0.0.0:8888
CORS_ALLOWED_ORIGINS=http://localhost:3000
RUST_LOG=info,open_nvr=debug

# Frontend
NUXT_PUBLIC_API_URL=http://localhost:8888
NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NUXT_PUBLIC_KEYCLOAK_REALM=opennvr
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=opennvr-frontend

# Encryption key for camera credentials (generate with: openssl rand -hex 32)
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# AI Models
ONNX_MODEL_PATH=./ai-models/models

# OpenSearch (optional - start with: docker compose --profile logging up -d)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_ENABLED=false
OPENSEARCH_INDEX_AUDIT=opennvr-audit-logs
OPENSEARCH_INDEX_NETWORK=opennvr-network-events
